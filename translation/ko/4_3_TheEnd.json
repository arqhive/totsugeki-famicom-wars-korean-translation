{
 "file": "4_3_TheEnd_Japanese.str",
 "scene": "4_3_TheEnd",
 "entries": [
  {
   "index": 1,
   "ko": "우벨, 오늘까지 살아남았다. 놀랍다."
  },
  {
   "index": 3,
   "ko": "대담하면서도 신중해야 한다. 그게 중요하니라, 우벨."
  },
  {
   "index": 5,
   "ko": "네놈에게 복수라는 이름으로 빚을 갚아 주마!"
  },
  {
   "index": 7,
   "ko": "이건 툰드라국이 겪은 고통이다!"
  },
  {
   "index": 9,
   "ko": "그리고 이건 아버님의 원한이다!"
  },
  {
   "index": 11,
   "ko": "그렇게는 안 되지!"
  },
  {
   "index": 13,
   "ko": "호오, 네놈들이 이긴 줄 아느냐?"
  },
  {
   "index": 15,
   "ko": "어리석은 것들…!"
  },
  {
   "index": 17,
   "ko": "짐을 얕보지 마라!"
  },
  {
   "index": 19,
   "ko": "자, 왜 그러느냐?"
  },
  {
   "index": 21,
   "ko": "노바, 그냥 내버려 둬요."
  },
  {
   "index": 23,
   "ko": "그러지, 베티."
  },
  {
   "index": 25,
   "ko": "하지만 아버님께 배운 게 있다면\n그건…"
  },
  {
   "index": 27,
   "ko": "평화를 원하는 자여, 대비하라!\n전쟁의 때를 위하여!"
  }
 ]
}
